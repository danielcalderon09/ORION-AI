# Controlled OpenRouter scripting (simulated and non-billable by default)
ORION_OPENROUTER_API_KEY=
ORION_SCRIPTING_PROVIDER=simulated
ORION_SCRIPTING_MODEL=
ORION_SCRIPTING_API_KEY=
ORION_SCRIPTING_BASE_URL=https://openrouter.ai/api/v1
ORION_SCRIPTING_ALLOW_BILLABLE_REQUESTS=false
ORION_SCRIPTING_ESTIMATED_COST_USD=
ORION_SCRIPTING_MAX_ESTIMATED_COST_USD=
ORION_SCRIPTING_TIMEOUT_SECONDS=120
ORION_SCRIPTING_MAX_TRANSPORT_ATTEMPTS=1
ORION_SCRIPTING_RETRY_BASE_DELAY_SECONDS=0.25
ORION_SCRIPTING_MAX_OUTPUT_TOKENS=8192
ORION_SCRIPTING_TEMPERATURE=0.2
ORION_SCRIPTING_MAX_RESPONSE_BYTES=2000000
ORION_SCRIPTING_MAX_REQUEST_RECORD_BYTES=2000000
ORION_SCRIPTING_MAX_PLAN_BYTES=1000000
ORION_SCRIPTING_MAX_SCRIPT_BYTES=2000000
# Proposed candidates only; ADR-020 does not activate either value:
# Primary economical: ORION_SCRIPTING_MODEL=google/gemini-2.5-flash-lite
# Quality fallback: ORION_SCRIPTING_MODEL=openai/gpt-4.1-mini

# OpenRouter image generation (simulated and non-billable by default)
ORION_IMAGE_ACQUISITION_PROVIDER=simulated
ORION_IMAGE_ACQUISITION_MODEL=google/gemini-3.1-flash-lite-image
ORION_IMAGE_ACQUISITION_API_KEY=
