ORION_IMAGE_ACQUISITION_ALLOW_BILLABLE_REQUESTS=false
ORION_IMAGE_ACQUISITION_ESTIMATED_COST_USD=
ORION_IMAGE_ACQUISITION_MAX_ESTIMATED_COST_USD=
