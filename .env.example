# Production Video Clip Generation (global/private; never accepted per job)
ORION_VIDEO_CLIP_GENERATION_PROVIDER=simulated
ORION_VIDEO_CLIP_GENERATION_MODEL=simulated-video-v1
ORION_VIDEO_CLIP_GENERATION_OUTPUT_FORMAT=mp4
ORION_VIDEO_CLIP_GENERATION_CODEC=h264
ORION_VIDEO_CLIP_GENERATION_RESOLUTION=720p
ORION_VIDEO_CLIP_GENERATION_GENERATE_AUDIO=false
ORION_VIDEO_CLIP_GENERATION_FRAME_RATE=24
ORION_VIDEO_CLIP_GENERATION_DURATION_SECONDS=4
ORION_VIDEO_CLIP_GENERATION_MAX_DURATION_SECONDS=10
ORION_VIDEO_CLIP_GENERATION_MAX_SOURCE_MANIFEST_BYTES=4000000
ORION_VIDEO_CLIP_GENERATION_MAX_VIDEO_BYTES=50000000
ORION_VIDEO_CLIP_GENERATION_MAX_MANIFEST_BYTES=4000000
ORION_VIDEO_CLIP_GENERATION_FFMPEG_PATH=
ORION_VIDEO_CLIP_GENERATION_FFPROBE_PATH=
ORION_VIDEO_CLIP_GENERATION_OPENROUTER_API_KEY=
ORION_VIDEO_CLIP_GENERATION_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
ORION_VIDEO_CLIP_GENERATION_OPENROUTER_TIMEOUT_SECONDS=30
ORION_VIDEO_CLIP_GENERATION_OPENROUTER_POLL_INTERVAL_SECONDS=5
ORION_VIDEO_CLIP_GENERATION_OPENROUTER_MAX_POLL_SECONDS=900
ORION_VIDEO_CLIP_GENERATION_OPENROUTER_MAX_POLL_ATTEMPTS=180
ORION_VIDEO_CLIP_GENERATION_OPENROUTER_MAX_RESPONSE_BYTES=2000000
ORION_VIDEO_CLIP_GENERATION_OPENROUTER_MAX_VIDEO_BYTES=50000000
ORION_VIDEO_CLIP_GENERATION_OPENROUTER_CAPABILITY_CACHE_TTL_SECONDS=3600
ORION_VIDEO_CLIP_GENERATION_MAX_ESTIMATED_COST_USD=1.00
ORION_VIDEO_CLIP_GENERATION_ALLOW_BILLABLE_REQUESTS=false
ORION_VIDEO_CLIP_GENERATION_FRAME_PUBLISHER=disabled

# Secure Asset Publishing (global/private; null by default, no cloud provider)
ORION_ASSET_PUBLISHING_PUBLISHER=null
ORION_ASSET_PUBLISHING_PUBLIC_ROOT=
