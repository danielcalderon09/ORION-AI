ORION_ASSET_PUBLISHING_LIFETIME_SECONDS=900
ORION_ASSET_PUBLISHING_MAX_ASSET_BYTES=250000000
ORION_ASSET_PUBLISHING_MAX_MANIFEST_BYTES=4000000

