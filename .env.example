ORION_IMAGE_ACQUISITION_MAX_TRANSPORT_ATTEMPTS=1
ORION_IMAGE_ACQUISITION_OUTPUT_FORMAT=png
ORION_IMAGE_ACQUISITION_QUALITY=auto

