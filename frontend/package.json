{
  "name": "orion-ai-frontend",
  "version": "0.1.0",
  "description": "Orion AI Desktop UI",
  "main": "src/main/main.js",
  "scripts": {
    "dev": "concurrently \"npx vite --port 5173\" \"npm run wait-and-start\"",
    "wait-and-start": "node -e \"setTimeout(()=>process.exit(0),3500)\" && npm run frontend",
    "frontend": "electron .",
    "build": "tsc && vite build"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "socket.io-client": "^4.7.5",
    "zustand": "^4.5.2",
    "react-dropzone": "^14.2.3"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "concurrently": "^8.2.2",
    "electron": "^30.0.0",
    "typescript": "^5.4.5",
    "vite": "^5.2.0"
  }
}
